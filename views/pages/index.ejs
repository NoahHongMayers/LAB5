<!DOCTYPE html>
<html lang="fr">

<%- include('../partials/head') %>

    <body>

        <div class="container">

            <!-- Navigation -->
            <%- include('../partials/header') %>

                <!-- Main content -->
                <main class="mt-3">

                    <p>Welcome to The List Page</p>

                    <div class="bg-light rounded p-4">
                        <h1>Item List</h1>

                        <table class="table table-light">
                            <thead>
                                <tr>
                                    <th>
                                        <button type="button" class="btn btn-light" onclick="sortTable(0)"># ↕</button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-light" onclick="sortTable(1)">Date Added
                                            ↕</button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-light" onclick="sortTable(2)">Item
                                            ↕</button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-light" onclick="sortTable(3)">Price
                                            ↕</button>
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                <% for (let i=0; i < items.length; i++) { %>
                                    <tr>
                                        <td>
                                            <%= items[i].id %>
                                        </td>
                                        <td>
                                            <%= items[i].creationDate %>
                                        </td>
                                        <td>
                                            <%= items[i].name %>
                                        </td>
                                        <td>
                                            <%= items[i].price %>
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>

                        <h2>Manage Items</h2>

                        <!-- Your existing ItemList table -->

                        <!-- Add item -->
                        <form method="POST" action="/add">
                            Add an Item <br>
                            <input type="text" name="name" placeholder="Item Name">
                            <input type="number" name="price" step="0.01" placeholder="Price">
                            <button type="submit" class="btn btn-secondary">Add</button>
                        </form>

                        <!-- Delete by ID -->
                        <form method="POST" action="/removeId">
                            Remove an Item by ID <br>
                            <input type="number" name="id">
                            <button type="submit" class="btn btn-secondary">Remove</button>
                        </form>

                        <!-- Delete by name -->
                        <form method="POST" action="/removeName">
                            Remove an Item by Name <br>
                            <input type="text" name="name">
                            <button type="submit" class="btn btn-secondary">Remove</button>
                        </form>

                        <!-- Modify by ID -->
                        <form method="POST" action="/modify">
                            Modify an Item by ID <br>
                            <input type="text" name="id" placeholder="Item ID">
                            <input type="text" name="newName" placeholder="New Item Name">
                            <input type="number" name="newPrice" step="0.01" placeholder="New Price">
                            <button type="submit" class="btn btn-secondary">Modify</button>
                        </form>

                    </div>

                </main>

                <!-- Footer -->
                <%- include('../partials/footer') %>

        </div>

        <% if (passedError) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= passedError %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>



                <script src="/socket.io/socket.io.js"></script>

                <script>
                    var socket = io();

                    socket.on('refresh', function () {
                        location.reload();
                    });

                    function sortTable(column) {
                        let table = document.querySelector("table");
                        let tbody = table.querySelector("tbody");
                        let rows = Array.from(tbody.querySelectorAll("tr"));

                        rows.sort(function (a, b) {
                            let valueA = a.cells[column].textContent.trim();
                            let valueB = b.cells[column].textContent.trim();

                            // Sort ID numerically
                            if (column == 0) {
                                return parseFloat(valueA) - parseFloat(valueB);
                            }

                            // Sort Date chronologically
                            if (column == 1) {
                                return new Date(valueA) - new Date(valueB);
                            }

                            // Sort Item alphabetically
                            if (column == 2) {
                                return valueA.localeCompare(valueB);
                            }

                            //sort Price numerically
                            if (column == 3) {
                                return parseFloat(valueA) - parseFloat(valueB);
                            }

                            return 0;
                        });

                        rows.forEach(function (row) {
                            tbody.appendChild(row);
                        });
                    }
                </script>

    </body>

</html>