<!DOCTYPE html>
<html>

<%- include('../partials/head.ejs') %>

    <body>

        <%- include('../partials/header.ejs') %>


            <h1>
                <%= title %>
            </h1>

            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Date de création</th>
                    </tr>
                </thead>

                <tbody>
                    <% items.forEach(item=> { %>
                        <tr>
                            <td>
                                <%= item.id %>
                            </td>
                            <td>
                                <%= item.nom %>
                            </td>
                            <td>
                                <%= item.prix %> $
                            </td>
                            <td>
                                <%= item.dateCreation %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>


            <%- include('../partials/footer.ejs') %>

    </body>

</html>