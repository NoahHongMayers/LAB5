<!DOCTYPE html>
<html lang="fr">

<%- include('../partials/head') %>

    <body>

        <div class="container">

            <!-- Navigation -->
            <%- include('../partials/header') %>

                <!-- Main content -->
                <main class="mt-3">

                    <p>Welcome to The List Page</p>

                    <div class="bg-light rounded p-4">
                        <h1>Item List</h1>

                        <table class="table table-light">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Date Added</th>
                                    <th>Item</th>
                                    <th>Price</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% for (let i = 0; i < items.length; i++) { %>
                                    <tr>
                                        <td>
                                            <%= items[i].id %>
                                        </td>
                                        <td>
                                            <%= items[i].creationDate %>
                                        </td>
                                        <td>
                                            <%= items[i].name %>
                                        </td>
                                        <td>
                                            <%= items[i].price %>
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>

                        <h2>Add or Remove Items</h2>

                        <!-- Your existing ItemList table -->

                        <!-- Add item -->
                        <form method="POST" action="/add">
                            Add an Item <br>
                            <input type="text" name="name" placeholder="Item Name">
                            <input type="number" name="price" step="0.01" placeholder="Price">
                            <button type="submit" class="btn btn-secondary">Add</button>
                        </form>

                        <!-- Delete by ID -->
                        <form method="POST" action="/removeId">
                            Remove an Item by ID <br>
                            <input type="number" name="id">
                            <button type="submit" class="btn btn-secondary">Remove</button>
                        </form>

                        <!-- Delete by name -->
                        <form method="POST" action="/removeName">
                            Remove an Item by Name <br>
                            <input type="text" name="name">
                            <button type="submit" class="btn btn-secondary">Remove</button>
                        </form> 

                    </div>

                </main>

                <!-- Footer -->
                <%- include('../partials/footer') %>

        </div>

    </body>

</html>